rules_version = '2';

// Reglas de seguridad para la Liga de Hándicap.
//
// Sigue sin haber cuentas de usuario ni Firebase Authentication: es una app "de honor"
// para un grupo cerrado de amigos que comparten el enlace, y el PIN de administrador
// (visible en el propio documento config/main, legible por cualquiera) no es una
// autenticación real. Por eso estas reglas siguen permitiendo leer y escribir a
// cualquiera que tenga la URL de la base de datos — eso no ha cambiado.
//
// Lo que sí hacen ahora es exigir que cada documento escrito tenga exactamente la forma
// que la app espera (los campos que usa, con los tipos y rangos razonables) y bloquear
// cualquier colección que la app no use. Esto no detiene a alguien del grupo que decida
// escribir algo raro a mano, pero sí bloquea la inmensa mayoría de bots/escáneres
// automáticos que encuentran la URL y prueban a escribir basura, documentos gigantes o
// colecciones inventadas — que es el riesgo real de tener la base de datos abierta.
//
// Si en el futuro se quiere un control de acceso de verdad, el siguiente paso sería
// añadir Firebase Authentication (aunque sea "anónima", sin pedir usuario/contraseña) y
// condicionar estas reglas a request.auth != null, y opcionalmente Firebase App Check
// para exigir que las peticiones vengan de esta app y no de un script cualquiera.

service cloud.firestore {
  match /databases/{database}/documents {

    function isStr(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    // Clima del día jugado (opcional, anotado solo, nunca exigido): ver `courseGeo` más
    // abajo y la sección dedicada en las decisiones del proyecto (25/8/2026).
    function isValidWeather(w) {
      return w is map && w.keys().hasOnly(['tmax', 'tmin', 'precip', 'windMax'])
        && (!('tmax' in w) || (w.tmax is number && w.tmax >= -30 && w.tmax <= 55))
        && (!('tmin' in w) || (w.tmin is number && w.tmin >= -40 && w.tmin <= 45))
        && (!('precip' in w) || (w.precip is number && w.precip >= 0 && w.precip <= 500))
        && (!('windMax' in w) || (w.windMax is number && w.windMax >= 0 && w.windMax <= 250));
    }

    // ---------------- players ----------------
    match /players/{id} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'team'])
        && isStr(request.resource.data.name, 80) && request.resource.data.name.size() > 0
        && (!('team' in request.resource.data) || isStr(request.resource.data.team, 80));
    }

    // ---------------- teams ----------------
    match /teams/{id} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name'])
        && isStr(request.resource.data.name, 80) && request.resource.data.name.size() > 0;
    }

    // ---------------- tees (catálogo de campos/barras) ----------------
    match /tees/{id} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['course', 'color', 'sr', 'cr', 'par', 'hidden'])
        && isStr(request.resource.data.course, 160)
        && isStr(request.resource.data.color, 40)
        && request.resource.data.sr is number && request.resource.data.sr >= 40 && request.resource.data.sr <= 170
        && request.resource.data.cr is number && request.resource.data.cr >= 20 && request.resource.data.cr <= 95
        && request.resource.data.par is number && request.resource.data.par >= 18 && request.resource.data.par <= 95
        && (!('hidden' in request.resource.data) || request.resource.data.hidden is bool);
    }

    // ---------------- rounds ----------------
    match /rounds/{id} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(
          ['player', 'course', 'tee', 'date', 'stableford', 'hcp', 'score', 'cr', 'sr', 'par',
           'differential', 'status', 'mode', 'dismissedSuspicious', 'weather'])
        && isStr(request.resource.data.player, 60)
        && isStr(request.resource.data.course, 160)
        && isStr(request.resource.data.tee, 40)
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.cr is number && request.resource.data.cr >= 20 && request.resource.data.cr <= 95
        && request.resource.data.sr is number && request.resource.data.sr >= 40 && request.resource.data.sr <= 170
        && request.resource.data.par is number && request.resource.data.par >= 18 && request.resource.data.par <= 95
        && request.resource.data.differential is number
        && request.resource.data.differential >= -50 && request.resource.data.differential <= 100
        && request.resource.data.status in ['pendiente', 'aprobada']
        && request.resource.data.mode in ['sf', 'raw']
        && (!('hcp' in request.resource.data) || (request.resource.data.hcp is number && request.resource.data.hcp >= -10 && request.resource.data.hcp <= 54))
        && (!('stableford' in request.resource.data) || (request.resource.data.stableford is number && request.resource.data.stableford >= 0 && request.resource.data.stableford <= 80))
        && (!('score' in request.resource.data) || (request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 300))
        && (!('dismissedSuspicious' in request.resource.data) || request.resource.data.dismissedSuspicious is bool)
        && (!('weather' in request.resource.data) || isValidWeather(request.resource.data.weather));
    }

    // ---------------- deletedRounds (papelera, registro histórico) ----------------
    match /deletedRounds/{id} {
      allow read: if true;
      allow delete: if true;
      allow update: if true; // la app actual no actualiza entradas de la papelera, solo las crea o borra
      allow create: if request.resource.data.keys().hasOnly(
          ['roundId', 'player', 'playerName', 'course', 'tee', 'date', 'score', 'hcp', 'stableford',
           'cr', 'sr', 'par', 'differential', 'status', 'mode', 'deletedAt', 'deletedByPlayerId',
           'deletedByPlayerName', 'deletedAsAdmin', 'reason'])
        && isStr(request.resource.data.course, 160)
        && isStr(request.resource.data.tee, 40);
    }

    // ---------------- courseGeo (caché de geocodificación para el clima del día jugado) ----------------
    match /courseGeo/{id} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['course', 'lat', 'lon'])
        && isStr(request.resource.data.course, 160)
        && request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lon is number && request.resource.data.lon >= -180 && request.resource.data.lon <= 180;
    }

    // ---------------- config/main ----------------
    match /config/main {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['pin', 'autoApprove'])
        && (!('pin' in request.resource.data) || isStr(request.resource.data.pin, 20))
        && (!('autoApprove' in request.resource.data) || request.resource.data.autoApprove is bool);
    }

    // ---------------- ryder/main (preparación de la Ryder Pucela Cup) ----------------
    // Documento de configuración libre (roster e emparejamientos anidados) para la pestaña
    // "Ryder", visible solo con el PIN de admin. A diferencia de las demás colecciones, aquí
    // no se valida la forma exacta del documento: es un array de jugadores/invitados y de
    // emparejamientos por formato cuya estructura puede evolucionar sin tener que tocar estas
    // reglas cada vez, y no afecta a la integridad del hándicap del grupo (players/rounds),
    // que sigue validado arriba. Mismo criterio de "honor system" que el resto de la app.
    match /ryder/{docId} {
      allow read, write: if true;
    }

    // Cualquier otra colección o documento que la app no use: bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
